{
  "rules": [
    {
      "id": "topic_required_non_empty",
      "description": "The 'topic' field in the front matter must be present and not empty.",
      "field": "front_matter.topic",
      "check": "required_non_empty",
      "severity": "error",
      "params": {}
    },
    {
      "id": "summary_single_sentence",
      "description": "The 'summary' field in the front matter must be a single sentence.",
      "field": "front_matter.summary",
      "check": "single_sentence",
      "severity": "error",
      "params": {}
    },
    {
      "id": "triggers_list_non_empty",
      "description": "The 'triggers' field in the front matter must be a non-empty list.",
      "field": "front_matter.triggers",
      "check": "is_list_non_empty",
      "severity": "error",
      "params": {}
    },
    {
      "id": "has_conditions_boolean",
      "description": "The 'has_conditions' field in the front matter must be a boolean value (true or false).",
      "field": "front_matter.has_conditions",
      "check": "is_boolean",
      "severity": "error",
      "params": {}
    },
    {
      "id": "related_chunks_list",
      "description": "The 'related_chunks' field in the front matter must be a list (can be empty).",
      "field": "front_matter.related_chunks",
      "check": "is_list",
      "severity": "error",
      "params": {}
    },
    {
      "id": "status_valid_values",
      "description": "The 'status' field in the front matter must have a value of 'active' or 'skipped'.",
      "field": "front_matter.status",
      "check": "valid_values",
      "severity": "error",
      "params": {
        "values": [
          "active",
          "skipped"
        ]
      }
    },
    {
      "id": "context_section_present",
      "description": "The '## Context' section must be present in the content.",
      "field": "content",
      "check": "section_present",
      "severity": "error",
      "params": {
        "heading": "## Context"
      }
    },
    {
      "id": "context_section_non_empty",
      "description": "The '## Context' section must have non-empty content.",
      "field": "content",
      "check": "section_non_empty",
      "severity": "error",
      "params": {
        "heading": "## Context"
      }
    },
    {
      "id": "response_section_present",
      "description": "The '## Response' section must be present in the content.",
      "field": "content",
      "check": "section_present",
      "severity": "error",
      "params": {
        "heading": "## Response"
      }
    },
    {
      "id": "response_contains_question_headings",
      "description": "The '## Response' section must contain at least one '### ' sub-heading.",
      "field": "content",
      "check": "content_matches_pattern",
      "severity": "error",
      "params": {
        "pattern": "### "
      }
    },
    {
      "id": "escalation_section_present",
      "description": "The '## Escalation' section must be present in the content.",
      "field": "content",
      "check": "section_present",
      "severity": "error",
      "params": {
        "heading": "## Escalation"
      }
    },
    {
      "id": "escalation_section_non_empty",
      "description": "The '## Escalation' section must have non-empty content.",
      "field": "content",
      "check": "section_non_empty",
      "severity": "error",
      "params": {
        "heading": "## Escalation"
      }
    },
    {
      "id": "conditional_conditions_section",
      "description": "If 'has_conditions' is true, the '### Conditions' section must be present in the content.",
      "field": "content",
      "check": "conditional_section",
      "severity": "error",
      "params": {
        "if_field": "front_matter.has_conditions",
        "if_value": true,
        "then_heading": "### Conditions"
      }
    },
    {
      "id": "conditional_if_pattern",
      "description": "If 'has_conditions' is true, the content must include '**If [condition]**' patterns.",
      "field": "content",
      "check": "conditional_pattern",
      "severity": "error",
      "params": {
        "if_field": "front_matter.has_conditions",
        "if_value": true,
        "pattern": "\\*\\*If "
      }
    }
  ]
}