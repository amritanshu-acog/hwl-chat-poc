# ─── AI Provider ──────────────────────────────────────────────────────────────
# Set AI_PROVIDER to one of: google | groq | azure
# If unset, the first provider whose API key is present is used automatically.

AI_PROVIDER=azure

# Google Gemini
GOOGLE_GENERATIVE_AI_API_KEY=

# Groq
GROQ_API_KEY=

# Azure OpenAI
AZURE_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_RESOURCE_NAME=<your-resource>
AZURE_API_VERSION=2024-12-01-preview

# ─── Per-stage model overrides (optional) ─────────────────────────────────────
# Leave blank to use the provider's default model for everything.
# Useful for cost optimisation: cheap model for triage, strong model for respond.
#
# MODEL_TRIAGE=gpt-4o-mini
# MODEL_RESPOND=gpt-4o
# MODEL_FORMAT=gpt-4o-mini
# MODEL_TITLE=gpt-4o-mini
#
# Override for a single run:
#   MODEL_RESPOND=gpt-4o bun run serve

# ─── Per-type format prompts (optional) ───────────────────────────────────────
# Default values below point to the plain-markdown format prompts.
# Swap to format-mdx-* variants for React/MDX UI deployments.
PROMPT_FORMAT_ANSWER=format-answer
PROMPT_FORMAT_OPTIONS=format-options
PROMPT_FORMAT_MIXED=format-mixed
PROMPT_FORMAT_CLARIFY=format-clarify
PROMPT_FORMAT_NOTFOUND=format-notfound

# ─── Other prompt overrides (optional) ────────────────────────────────────────
# PROMPT_TRIAGE=triage
# PROMPT_RESPOND=respond
# PROMPT_TITLE=title

# ─── Sessions ─────────────────────────────────────────────────────────────────
SESSIONS_DIR=./data/sessions
MAX_TURNS_PER_SESSION=20

# ─── Retrieval ────────────────────────────────────────────────────────────────
CLARIFICATION_LIMIT=2
GUIDE_TTL_SECONDS=300

# ─── Server ───────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
# MAX_BODY_BYTES=65536
# REQUEST_TIMEOUT_MS=120000
# CIRCUIT_BREAKER_THRESHOLD=5
# CIRCUIT_BREAKER_RESET_MS=60000

# ─── Auth (HTTP API only) ─────────────────────────────────────────────────────
JWT_ALGORITHM=HS256         # HS256 (shared secret) or RS256 (public key / JWKS)
JWT_USER_ID_CLAIM=sub       # JWT claim to use as user_id for session storage

# HS256 — set a strong random secret (min 32 chars):
JWT_SECRET=

# RS256 — set ONE of:
# JWKS_URL=https://your-auth-provider/.well-known/jwks.json
# JWT_PUBLIC_KEY=<PEM-encoded RSA public key>

# ─── Logging ──────────────────────────────────────────────────────────────────
# LOG_DIR=./logs

# ─── Generation pipeline (if running generation from same project root) ───────
# PROJECT_ROOT is auto-detected from process.cwd() — only set if you run the
# server from a different directory.
# PROJECT_ROOT=/absolute/path/to/troubleshooting-poc